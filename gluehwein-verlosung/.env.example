# Zugang für das Team am Stand (Codes erzeugen). Mindestens 6 Zeichen.
STAND_PIN=
# Zugang für die Verwaltung (Teilnehmerliste, Export, Ziehung). Langes Passwort.
ADMIN_PASSWORD=
# Öffentliche Adresse der App, wie sie im QR-Code stehen soll (ohne Schrägstrich am Ende)
PUBLIC_URL=https://lose.example.at
# Für die Datenschutzerklärung
VERANSTALTER=Name des Vereins / der Organisation
KONTAKT_EMAIL=kontakt@example.at
# Ordner für die Datenbank. MUSS auf einem dauerhaften Speicher liegen.
DATA_DIR=./data
PORT=3000
